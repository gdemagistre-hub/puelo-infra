rules_version = '2';
// 2026-08-24: claim ausente no rompe isOwnerPath.
service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }
    function underLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }
    function isDevImpersonation() {
      return request.auth != null
        && request.auth.token.get('dev_impersonation', false) == true;
    }
    function isOwnerPath(userId) {
      return request.auth != null
        && !isDevImpersonation()
        && request.auth.uid == userId;
    }

    match /usuarios/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwnerPath(userId)
        && (request.resource == null || (underLimit() && isImage()));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
