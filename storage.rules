rules_version = '2';
// Sprint 0: writes requieren Auth y path bajo usuarios/{uid}/.
// Lectura pública de imágenes de perfil/portfolio (URLs en tarjeta pública).
// 2026-08-24: tokens con claim dev_impersonation no pueden escribir.
service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }
    function underLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }
    function isDevImpersonation() {
      return request.auth != null && request.auth.token.dev_impersonation == true;
    }
    function isOwnerPath(userId) {
      return request.auth != null
        && !isDevImpersonation()
        && request.auth.uid == userId;
    }

    match /usuarios/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwnerPath(userId)
        && (request.resource == null || (underLimit() && isImage()));
    }

    // Deny-by-default resto del bucket
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
