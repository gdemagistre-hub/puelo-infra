rules_version = '2';
// 2026-08-25: lectura pública sólo foto_perfil + portfolio.
// DNI, documentos y capacitaciones: dueño (o sesión para capacitaciones).
service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }
    function underLimit() {
      return request.resource.size < 5 * 1024 * 1024;
    }
    function isDevImpersonation() {
      return request.auth != null
        && request.auth.token.get('dev_impersonation', false) == true;
    }
    function isSignedIn() {
      return request.auth != null && !isDevImpersonation();
    }
    function isOwnerPath(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function imageWrite() {
      return request.resource == null || (underLimit() && isImage());
    }

    match /usuarios/{userId}/foto_perfil.jpg {
      allow read: if true;
      allow write: if isOwnerPath(userId) && imageWrite();
    }

    match /usuarios/{userId}/portfolio/{fileName} {
      allow read: if true;
      allow write: if isOwnerPath(userId) && imageWrite();
    }

    match /usuarios/{userId}/capacitaciones/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwnerPath(userId) && imageWrite();
    }

    match /usuarios/{userId}/{allPaths=**} {
      allow read: if isOwnerPath(userId);
      allow write: if isOwnerPath(userId) && imageWrite();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
