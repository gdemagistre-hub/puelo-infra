rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin vía custom claim (preferido) o usuarios/{uid}.es_admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.es_admin == true
      );
    }

    function analyticsKeysOk() {
      let forbidden = ['email', 'telefono', 'phone', 'celular', 'nombre', 'apellido',
                       'documento', 'dni', 'calle', 'password', 'token', 'whatsapp'];
      return !request.resource.data.keys().hasAny(forbidden);
    }

    function analyticsSizeOk() {
      return request.resource.data.keys().size() <= 24;
    }

    // ---------- analytics ----------
    match /analytics_events/{id} {
      allow create: if analyticsKeysOk() && analyticsSizeOk()
        && request.resource.data.type is string
        && request.resource.data.session_id is string;
      // TEMP: lectura abierta (ConsolaProx gate client-side).
      // Con Auth estricto: allow read: if isAdmin();
      allow read: if true;
      allow update, delete: if false;
    }

    // ---------- stats / batch ----------
    match /stats/{doc} {
      allow read: if true;
      // TEMP: batch scoring desde cliente. Con Auth: isAdmin()
      allow write: if true;
    }

    // ---------- catálogos geo (solo lectura) ----------
    match /cat_paises/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /cat_departamentos/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /cat_localidades/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- usuarios ----------
    // Convención con Google Auth (y futuros FB/Apple):
    //   doc id = Firebase Auth uid
    //   campos: auth_provider, auth_uid, email, url_foto_perfil, estado, …
    //
    // TEMP pre-lanzamiento: write abierto para:
    //   - ensureUserProfile post-Google
    //   - impersonación por dropdown (sin request.auth)
    // Al abrir al público + apagar dropdown:
    //   allow read: if true;
    //   allow create: if isSignedIn() && request.auth.uid == userId;
    //   allow update: if isSignedIn() && request.auth.uid == userId;
    //   allow delete: if isAdmin();
    match /usuarios/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // ---------- trabajos ----------
    match /trabajos/{id} {
      allow read: if true;
      allow write: if true; // TEMP
    }

    // ---------- validaciones / tokens ----------
    match /validaciones/{id} {
      allow read, write: if true; // TEMP
    }
    match /validacion_tokens/{id} {
      allow read, write: if true; // TEMP
    }

    // ---------- default DENY ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
