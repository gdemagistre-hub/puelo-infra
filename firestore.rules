rules_version = '2';
// Sprint 0 (2026-08-06): cierre de superficie privilegiada.
// 2026-08-14: Mis números DB única.
// 2026-08-14: Mensajes M1 conversaciones/eventos append-only (write CF only).
// 2026-08-14: fiados (Me deben) subcolección owner-only.
// 2026-08-18: Phase 1 scoring_features (Vertex export, admin only).
// 2026-08-18: stats write admin (batch lock scoring_job + runs).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.es_admin == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFlutterFlow() {
      return isSignedIn()
        && request.auth.token.email.matches('firebase@flutterflow.io');
    }

    function privilegedKeys() {
      return [
        'es_admin',
        'scoring',
        'badge_prestador',
        'riesgo_fraude',
        'fraud_flags',
        'score_identidad',
        'score_reputacion',
        'score_actividad',
        'score_total'
      ];
    }

    function createHasNoPrivileged() {
      return !request.resource.data.keys().hasAny(privilegedKeys());
    }

    function updateTouchesNoPrivileged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(privilegedKeys());
    }

    function analyticsKeysOk() {
      let forbidden = ['email', 'telefono', 'phone', 'celular', 'nombre', 'apellido',
                       'documento', 'dni', 'calle', 'password', 'token', 'whatsapp'];
      return !request.resource.data.keys().hasAny(forbidden);
    }

    function analyticsSizeOk() {
      return request.resource.data.keys().size() <= 24;
    }

    match /{document=**} {
      allow read, write: if isFlutterFlow();
    }

    match /analytics_events/{id} {
      allow create: if analyticsKeysOk() && analyticsSizeOk()
        && request.resource.data.type is string
        && request.resource.data.session_id is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /contactos/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // stats: scoring_job lock/runs + agregados — solo admin
    match /stats/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    match /cat_paises/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_departamentos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_localidades/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_oficios/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /usuarios/{userId} {
      allow read: if true;

      allow create: if createHasNoPrivileged()
        && (
          !isSignedIn()
          || isOwner(userId)
          || isAdmin()
        );

      allow update: if (
          isAdmin()
        ) || (
          updateTouchesNoPrivileged()
          && (
            isOwner(userId)
            || !isSignedIn()
          )
        );

      allow delete: if isAdmin();

      match /movimientos/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /metas/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /vencimientos/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /fiados/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /vault/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /trabajos/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || (isSignedIn()
        && resource.data.keys().hasAny(['usuario_id', 'usuarioId', 'uid'])
        && (
          resource.data.usuario_id == request.auth.uid
          || resource.data.usuarioId == request.auth.uid
          || resource.data.uid == request.auth.uid
        ));
    }

    match /trabajos_galeria/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /calificaciones/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /validaciones/{id} {
      allow read, write: if false;
    }
    match /validacion_tokens/{id} {
      allow read, write: if false;
    }
    match /validaciones_pendientes/{id} {
      allow read, write: if false;
    }

    // Mensajes M1 — recibos auditables (append-only). Write solo via CF (Admin SDK).
    match /conversaciones/{convId} {
      function isConvParticipant() {
        return isSignedIn()
          && resource.data.keys().hasAny(['participantes'])
          && request.auth.uid in resource.data.participantes;
      }
      allow read: if isConvParticipant() || isAdmin();
      allow create, update, delete: if false;

      match /eventos/{eventId} {
        function isParentParticipant() {
          return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(convId)).data.participantes;
        }
        allow read: if isParentParticipant() || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // Phase 1: feature vectors for Vertex (admin / batch only)
    match /scoring_features/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
