rules_version = '2';
// 2026-08-24: usuarios sin write anónimo.
// 2026-08-24 etapa 5 Aikido: list de usuarios exige sesión (cierra enumeración masiva).
// 2026-08-24 etapa 1 PII: DNI/email/calle en usuarios/{uid}/privado (dueño/admin).
// get del padre queda abierto: proyección pública (nombre, badge, zona, foto, tel).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDevImpersonation() {
      return request.auth != null
        && request.auth.token.get('dev_impersonation', false) == true;
    }

    function isAdmin() {
      return isSignedIn() && !isDevImpersonation() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.es_admin == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && !isDevImpersonation() && request.auth.uid == userId;
    }

    function isFlutterFlow() {
      return isSignedIn()
        && request.auth.token.email.matches('firebase@flutterflow.io');
    }

    function privilegedKeys() {
      return [
        'es_admin',
        'scoring',
        'badge_prestador',
        'riesgo_fraude',
        'fraud_flags',
        'score_identidad',
        'score_reputacion',
        'score_actividad',
        'score_total'
      ];
    }

    function createHasNoPrivileged() {
      return !request.resource.data.keys().hasAny(privilegedKeys());
    }

    function updateTouchesNoPrivileged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(privilegedKeys());
    }

    function analyticsKeysOk() {
      let forbidden = ['email', 'telefono', 'phone', 'celular', 'nombre', 'apellido',
                       'documento', 'dni', 'calle', 'password', 'token', 'whatsapp'];
      return !request.resource.data.keys().hasAny(forbidden);
    }

    function analyticsSizeOk() {
      return request.resource.data.keys().size() <= 24;
    }

    match /{document=**} {
      allow read, write: if isFlutterFlow();
    }

    match /analytics_events/{id} {
      allow create: if analyticsKeysOk() && analyticsSizeOk()
        && request.resource.data.type is string
        && request.resource.data.session_id is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /contactos/{id} {
      allow create: if isSignedIn()
        && request.resource.data.cliente_uid == request.auth.uid
        && request.resource.data.prestador_uid is string
        && request.resource.data.prestador_uid.size() > 0
        && request.resource.data.cliente_uid != request.resource.data.prestador_uid
        && request.resource.data.tipo in ['whatsapp', 'llamada']
        && request.resource.data.origen in ['buscador', 'tarjeta'];
      allow read: if isAdmin()
        || (isSignedIn() && (
          resource.data.prestador_uid == request.auth.uid
          || resource.data.cliente_uid == request.auth.uid
        ));
      allow update, delete: if false;
    }

    match /stats/{doc} {
      allow read: if isAdmin() || doc == 'top_servicios';
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    match /demanda_eventos/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['oficio_id', 'fuente', 'created_at'])
        && request.resource.data.oficio_id is string
        && request.resource.data.oficio_id.size() > 0
        && request.resource.data.oficio_id.size() < 48
        && request.resource.data.fuente is string
        && request.resource.data.fuente.size() < 32;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /cat_paises/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_departamentos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_localidades/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_oficios/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /usuarios/{userId} {
      // Proyección pública (nombre, badge, zona, foto, tel). PII en /privado.
      allow get: if true;
      allow list: if isSignedIn();

      allow create: if createHasNoPrivileged()
        && (isOwner(userId) || isAdmin());

      allow update: if isAdmin()
        || (isOwner(userId) && updateTouchesNoPrivileged());

      allow delete: if isAdmin();

      match /privado/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /movimientos/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /metas/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /vencimientos/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /fiados/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /vault/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /trabajos/{id} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.tipo in ['portfolio', 'evaluacion']
        && (
          (
            request.resource.data.tipo == 'portfolio'
            && request.resource.data.usuario_id == request.auth.uid
          ) || (
            request.resource.data.tipo == 'evaluacion'
            && request.resource.data.clienteRef == /databases/$(database)/documents/usuarios/$(request.auth.uid)
          )
        );
      allow update: if isAdmin() || (
        isSignedIn() && (
          (
            resource.data.tipo == 'portfolio'
            && resource.data.usuario_id == request.auth.uid
          ) || (
            resource.data.tipo == 'evaluacion'
            && resource.data.clienteRef == /databases/$(database)/documents/usuarios/$(request.auth.uid)
          )
        )
      );
      allow delete: if isAdmin() || (isSignedIn()
        && resource.data.tipo == 'portfolio'
        && resource.data.usuario_id == request.auth.uid);
    }

    match /trabajos_galeria/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /calificaciones/{id} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.cliente_id == request.auth.uid
        && request.resource.data.prestador_id is string
        && request.resource.data.prestador_id.size() > 0
        && request.resource.data.cliente_id != request.resource.data.prestador_id
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /validaciones/{id} {
      allow read, write: if false;
    }
    match /validacion_tokens/{id} {
      allow read, write: if false;
    }
    match /validaciones_pendientes/{id} {
      allow read, write: if false;
    }

    match /conversaciones/{convId} {
      function isConvParticipant() {
        return isSignedIn()
          && resource.data.keys().hasAny(['participantes'])
          && request.auth.uid in resource.data.participantes;
      }
      allow read: if isConvParticipant() || isAdmin();
      allow create, update, delete: if false;

      match /eventos/{eventId} {
        function isParentParticipant() {
          return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(convId)).data.participantes;
        }
        allow read: if isParentParticipant() || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /scoring_features/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
