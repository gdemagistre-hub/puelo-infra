rules_version = '2';
// Sprint 0 (2026-08-06): cierre de superficie privilegiada.
// Menú "Modo prueba (equipo)" se mantiene: lectura de usuarios + writes de
// campos de perfil NO privilegiados (sin Auth) siguen habilitados TEMP.
// NO abrir al público sin: Auth obligatorio en writes + custom claims admin.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin: preferir custom claim. Campo es_admin solo si hay Auth (no se puede
    // auto-asignar: writes de es_admin están bloqueados abajo).
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.es_admin == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // FlutterFlow (si aún se usa ese email de servicio)
    function isFlutterFlow() {
      return isSignedIn()
        && request.auth.token.email.matches('firebase@flutterflow.io');
    }

    // Campos que el cliente NUNCA puede crear/modificar (solo Admin SDK / claim admin)
    function privilegedKeys() {
      return [
        'es_admin',
        'scoring',
        'badge_prestador',
        'riesgo_fraude',
        'fraud_flags',
        'score_identidad',
        'score_reputacion',
        'score_actividad',
        'score_total'
      ];
    }

    function createHasNoPrivileged() {
      return !request.resource.data.keys().hasAny(privilegedKeys());
    }

    function updateTouchesNoPrivileged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(privilegedKeys());
    }

    function analyticsKeysOk() {
      let forbidden = ['email', 'telefono', 'phone', 'celular', 'nombre', 'apellido',
                       'documento', 'dni', 'calle', 'password', 'token', 'whatsapp'];
      return !request.resource.data.keys().hasAny(forbidden);
    }

    function analyticsSizeOk() {
      return request.resource.data.keys().size() <= 24;
    }

    // ---------- FlutterFlow (opcional, acotado) ----------
    match /{document=**} {
      allow read, write: if isFlutterFlow();
    }

    // ---------- analytics ----------
    match /analytics_events/{id} {
      // Create: permite buffer cliente (también sesión dev sin Auth) con keys sanitizadas
      allow create: if analyticsKeysOk() && analyticsSizeOk()
        && request.resource.data.type is string
        && request.resource.data.session_id is string;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- contactos (leads WhatsApp / llamada) ----------
    // TEMP: create abierto para impersonación (dropdown). Cerrar con Auth al go-live.
    match /contactos/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- stats / batch: solo Admin SDK (Functions / GH Actions) ----------
    match /stats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
      match /{document=**} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ---------- catálogos (solo lectura pública) ----------
    match /cat_paises/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_departamentos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_localidades/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_oficios/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- usuarios ----------
    // read: true → buscador + dropdown "Modo prueba"
    // write: TEMP sin Auth para campos de perfil; privilegios bloqueados
    match /usuarios/{userId} {
      allow read: if true;

      allow create: if createHasNoPrivileged()
        && (
          !isSignedIn()
          || isOwner(userId)
          || isAdmin()
        );

      allow update: if (
          isAdmin()
        ) || (
          updateTouchesNoPrivileged()
          && (
            // Sesión real: dueño del doc
            isOwner(userId)
            // TEMP Sprint0: dropdown sin Auth puede editar perfil no privilegiado
            || !isSignedIn()
          )
        );

      allow delete: if isAdmin();
    }

    // ---------- trabajos ----------
    match /trabajos/{id} {
      allow read: if true;
      // TEMP: create/update abiertos (portfolio / carga con impersonación)
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || (isSignedIn()
        && resource.data.keys().hasAny(['usuario_id', 'usuarioId', 'uid'])
        && (
          resource.data.usuario_id == request.auth.uid
          || resource.data.usuarioId == request.auth.uid
          || resource.data.uid == request.auth.uid
        ));
    }

    match /trabajos_galeria/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // ---------- calificaciones (create cliente; update scoring solo Admin SDK) ----------
    match /calificaciones/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- validaciones / tokens: solo Cloud Functions (Admin SDK) ----------
    match /validaciones/{id} {
      allow read, write: if false;
    }
    match /validacion_tokens/{id} {
      allow read, write: if false;
    }
    match /validaciones_pendientes/{id} {
      allow read, write: if false;
    }

    // ---------- default DENY ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
