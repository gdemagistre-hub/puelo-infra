rules_version = '2';
// PERFORMANCE NOTE: writes TEMP abiertos pre-lanzamiento (dropdown).
// Cerrar antes de tráfico real: ver docs/performance.md
// 2026-08-05: redeploy — validaciones / validaciones_pendientes / calificaciones abiertos (flujo Ayudar a validar)
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin vía custom claim o usuarios/{uid}.es_admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.es_admin == true
      );
    }

    // FlutterFlow (si aún se usa ese email de servicio)
    function isFlutterFlow() {
      return isSignedIn()
        && request.auth.token.email.matches('firebase@flutterflow.io');
    }

    function analyticsKeysOk() {
      let forbidden = ['email', 'telefono', 'phone', 'celular', 'nombre', 'apellido',
                       'documento', 'dni', 'calle', 'password', 'token', 'whatsapp'];
      return !request.resource.data.keys().hasAny(forbidden);
    }

    function analyticsSizeOk() {
      return request.resource.data.keys().size() <= 24;
    }

    // ---------- FlutterFlow (opcional) ----------
    match /{document=**} {
      allow read, write: if isFlutterFlow();
    }

    // ---------- analytics ----------
    match /analytics_events/{id} {
      allow create: if analyticsKeysOk() && analyticsSizeOk()
        && request.resource.data.type is string
        && request.resource.data.session_id is string;
      allow read: if true;
      allow update, delete: if false;
    }

    // ---------- contactos (leads de WhatsApp / llamada) ----------
    // Create abierto TEMP (incluye impersonación dropdown sin Auth).
    // Luego: allow create: if isSignedIn() && request.resource.data.cliente_uid == request.auth.uid;
    match /contactos/{id} {
      allow create: if true;
      allow read: if true; // TEMP — luego isAdmin() o prestador_uid == auth.uid
      allow update, delete: if false;
    }

    // ---------- stats / batch ----------
    match /stats/{doc} {
      allow read: if true;
      // TEMP: batch scoring desde cliente (+ subcolección runs). Luego: isAdmin()
      allow write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // ---------- catálogos (solo lectura pública) ----------
    match /cat_paises/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_departamentos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_localidades/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_oficios/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- usuarios ----------
    match /usuarios/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // ---------- trabajos ----------
    match /trabajos/{id} {
      allow read: if true;
      allow write: if true; // TEMP
    }

    match /trabajos_galeria/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /calificaciones/{id} {
      allow read, create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // ---------- validaciones / tokens ----------
    match /validaciones/{id} {
      allow read, write: if true; // TEMP
    }
    match /validacion_tokens/{id} {
      allow read, write: if true; // TEMP
    }
    match /validaciones_pendientes/{id} {
      allow read, write: if true; // TEMP
    }

    // ---------- default DENY ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
