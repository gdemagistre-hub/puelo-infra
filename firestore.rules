rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin vía custom claim o usuarios/{uid}.es_admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.es_admin == true
      );
    }

    // FlutterFlow (si aún se usa ese email de servicio)
    function isFlutterFlow() {
      return isSignedIn()
        && request.auth.token.email.matches('firebase@flutterflow.io');
    }

    function analyticsKeysOk() {
      let forbidden = ['email', 'telefono', 'phone', 'celular', 'nombre', 'apellido',
                       'documento', 'dni', 'calle', 'password', 'token', 'whatsapp'];
      return !request.resource.data.keys().hasAny(forbidden);
    }

    function analyticsSizeOk() {
      return request.resource.data.keys().size() <= 24;
    }

    // ---------- FlutterFlow (opcional) ----------
    match /{document=**} {
      allow read, write: if isFlutterFlow();
    }

    // ---------- analytics ----------
    match /analytics_events/{id} {
      allow create: if analyticsKeysOk() && analyticsSizeOk()
        && request.resource.data.type is string
        && request.resource.data.session_id is string;
      allow read: if true;
      allow update, delete: if false;
    }

    // ---------- stats / batch ----------
    match /stats/{doc} {
      allow read: if true;
      // TEMP: batch scoring desde cliente (+ subcolección runs). Luego: isAdmin()
      allow write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // ---------- catálogos (solo lectura pública) ----------
    match /cat_paises/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_departamentos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_localidades/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cat_oficios/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- usuarios ----------
    // Doc id = Auth uid (Google / futuros FB-Apple)
    // TEMP pre-lanzamiento: write abierto para:
    //   - ensureUserProfile post-Google
    //   - impersonación por dropdown (sin request.auth)
    // Al abrir al público + apagar dropdown:
    //   allow create, update: if isSignedIn() && request.auth.uid == userId;
    //   allow delete: if isAdmin();
    match /usuarios/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // ---------- trabajos ----------
    match /trabajos/{id} {
      allow read: if true;
      allow write: if true; // TEMP
    }

    match /trabajos_galeria/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /calificaciones/{id} {
      allow read, create: if true;
      // TEMP: F1 del batch publica estados (timeout 7d). Luego: isAdmin() o Function only
      allow update: if true;
      allow delete: if isAdmin();
    }

    // ---------- validaciones / tokens ----------
    match /validaciones/{id} {
      allow read, write: if true; // TEMP
    }
    match /validacion_tokens/{id} {
      allow read, write: if true; // TEMP
    }

    // ---------- default DENY ----------
    // Sin regla abierta por fecha (la anterior venció 2026-07-31).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
